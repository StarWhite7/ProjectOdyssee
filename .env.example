# Public web configuration (safe to expose)
APP_ENV=development
APP_URL=http://localhost:4200
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only configuration (never prefix with NG_APP_ or expose to Angular)
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_FREEFORM_ACTION_LENGTH=1500
RECENT_TURNS_CONTEXT_COUNT=6
SUMMARY_INTERVAL_TURNS=8
REALTIME_DEFAULT_TIMER_SECONDS=120
